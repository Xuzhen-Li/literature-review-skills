# Copy into <project>/project.yaml. The homepage gate is set only after an exact sentence.
# The agent does not change narrative_core_cap after the user confirms this file.

title: "Working title"
topic: "One sentence on what the user wants to know"
field: "Discipline"
review_type: systematic
audience: "Who will read the review"
timeline: "Target month or date the user gave"
target_journal: undecided
language: en
search_pubmed: true
narrative_core_cap: 500
# open_access (default): the agent searches free APIs and downloads open-access PDFs itself.
# institutional or unavailable only after the optional institutional_access sentence.
download_access: open_access
# Optional extras. Leave false unless the user asks for them.
use_subscription_databases: false
use_zotero: false
created: 2026-10-09
updated: 2026-10-09
gates:
  institutional_access: false   # optional; not needed for the default flow
  topic_lock: false
  search_lock: false
  inclusion_lock: false
  outline_lock: false
  journal_lock: false
  final_submit: false
